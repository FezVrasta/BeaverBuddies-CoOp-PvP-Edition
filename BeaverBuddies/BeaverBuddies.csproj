<Project Sdk="Microsoft.NET.Sdk">

  <!-- Import system-specific properties -->
  <Import Project="env.props" Condition="Exists('env.props')" />
  <!-- Or the default properties if they don't exist -->
  <Import Project="env.props.windows-template" Condition="!Exists('env.props') AND '$(OS)' != 'Unix'" />
  <Import Project="env.props.unix-template" Condition="!Exists('env.props') AND '$(OS)' == 'Unix'" />

  <!-- Game Modes as installed in the Mods folder (build it from its repo, or point GameModesDll at its DLL) -->
  <PropertyGroup>
    <GameModesDll Condition="'$(GameModesDll)' == ''">$(DocumentsPath)Timberborn/Mods/GameModes/version-1.1/GameModes.dll</GameModesDll>
  </PropertyGroup>
  <Target Name="CheckGameModes" BeforeTargets="BeforeBuild">
    <Error Text="Game Modes isn't built: $(GameModesDll) not found. Build github.com/FezVrasta/timberborn-game-modes (it installs itself into the Mods folder) or set GameModesDll to its DLL" Condition="!Exists('$(GameModesDll)')" />
  </Target>

  <!-- Before building, create a copy if it doesn't exist -->
  <Target Name="EnsureEnvProps" BeforeTargets="CheckEnv">
    <Message Importance="high" Text="Checking for env.props file..." />
    <Exec Command="if not exist env.props copy env.props.windows-template env.props" Condition=" '$(OS)' != 'Unix'" />
    <Exec Command="test -e env.props || cp env.props.unix-template env.props" Condition=" '$(OS)' == 'Unix'" />
  </Target>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BeaverBuddies</AssemblyName>
    <Description>TimberModTest</Description>
    <Version>1.1.0-1.10.1</Version>
    <TimberbornTargetVersion>1.1</TimberbornTargetVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <NoWarn>$(NoWarn)</NoWarn>
    <!-- Path Config -->
    <BeaverBuddiesModsPath>$(DocumentsPath)Timberborn\Mods\BeaverBuddies\</BeaverBuddiesModsPath>
    <VersionOutputPath>$(BeaverBuddiesModsPath)version-$(TimberbornTargetVersion)\</VersionOutputPath>
    <!-- Old env.props files use the TimberbornPath, make that compatible with the new OS-independent TimberbornPath -->
    <TimberbornDataPath Condition="'$(TimberbornDataPath)' == ''">$(TimberbornPath)Timberborn_Data\</TimberbornDataPath>
    <TimberbornManagedPath>$(TimberbornDataPath)Managed\</TimberbornManagedPath>
    <NuGetPackagesDir>$(UserProfile)\.nuget\packages\</NuGetPackagesDir>
    <Configurations>Debug;Release;Debug Steam;Release Steam</Configurations>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ModSettingsPath>$(ModSettingsBasePath)version-$(TimberbornTargetVersion)\Scripts\</ModSettingsPath>
  </PropertyGroup>

  <!-- Every build is the Steam one, whatever the configuration: the mod ships on the Workshop, and a
       build without Steam networking and matchmaking installs over it in the Mods folder all the same.
       A build without them only on purpose: dotnet build -p:Steam=false -->
  <PropertyGroup>
    <Steam Condition="'$(Steam)' == ''">true</Steam>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Steam)' == 'true'">
    <DefineConstants>$(DefineConstants);IS_STEAM;MOVEMENT_SUBSTEPS</DefineConstants>
  </PropertyGroup>

  <Target Name="CheckEnv" BeforeTargets="BeforeBuild">
    <Warning Text="TimberbornPath property is deprecated, use the more specific TimberbornDataPath instead" Condition="'$(TimberbornDataPath)' == ''" />
    <Error Text="TimberbornDataPath property directory not found" Condition="!Exists('$(TimberbornDataPath)')" />
    <Error Text="HarmonyPath property directory not found" Condition="!Exists('$(HarmonyPath)')" />
    <Error Text="ModSettingsBasePath property directory not found" Condition="!Exists('$(ModSettingsBasePath)')" />
    <Error Text="DocumentsPath property directory not found" Condition="!Exists('$(DocumentsPath)')" />
  </Target>

  <!-- NuGet -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" ExcludeAssets="runtime">
      <PrivateAssets>all</PrivateAssets>
      <PublicizeCompilerGenerated>false</PublicizeCompilerGenerated>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
    <PackageReference Include="MonoMod.Core" Version="1.3.4" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.4" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="16.*" />
  </ItemGroup>

  <!-- Outside Project -->
  <ItemGroup>
    <ProjectReference Include="..\TimberNet\TimberNet.csproj" />
    <!-- The mod it depends on, a mod of its own (github.com/FezVrasta/timberborn-game-modes): its DLL stays in its own mod folder -->
    <Reference Include="$(GameModesDll)" Private="false" />
  </ItemGroup>

  <!-- Reference DLL -->
  <ItemGroup>
    <!-- Harmony -->
    <Reference Include="$(HarmonyPath)0Harmony.dll" Private="false" />

    <!-- Timberborn DLL & Publicize (BepInEx.AssemblyPublicizer.MSBuild) -->
    <Reference Include="$(TimberbornManagedPath)com.rlabrecque.steamworks.net.dll" Private="false" />
    <Reference Include="$(TimberbornManagedPath)Bindito.Core.dll" Publicize="true" Private="false" />
    <Reference Include="$(TimberbornManagedPath)Bindito.Unity.dll" Private="false" />
    <Reference Include="$(TimberbornManagedPath)UnityEngine.*.dll" Publicize="true" Private="false" />
    <Reference Include="$(TimberbornManagedPath)Unity.InputSystem.dll" Publicize="true" Private="false" />
    <Reference Include="$(TimberbornManagedPath)Timberborn.*.dll" Publicize="true" Private="false" />
    <Reference Include="$(ModSettingsPath)ModSettings.*.dll" Private="false" />
    <Compile Remove="Fixes\TestingStrategies_Scrap.cs" />
    <None Include="Fixes\TestingStrategies_Scrap.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="changelog.txt" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="changelog.txt" />
  </ItemGroup>

  <!-- Add files to Output folder -->
  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="thumbnail.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="workshop_data.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Localizations\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="KeyBindings\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="KeyBindingGroups\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Buildings\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TemplateCollections\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Sprites\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- PreBuild -->
  <!-- SIPSorcery's older dependencies bring netstandard 1.x facades of the base library along. The
       game has those types already, and it loads every DLL in the mod's folder: one of these stops
       the whole mod from loading (a ReflectionTypeLoadException for System.Collections 4.0.10). -->
  <PropertyGroup>
    <DroppedFacades>;Microsoft.CSharp;Microsoft.Win32.Registry;System.AppContext;System.Collections.Concurrent;System.Dynamic.Runtime;System.IO.Compression.ZipFile;System.IO.FileSystem.Primitives;System.Linq;System.Linq.Expressions;System.ObjectModel;System.Reflection.Emit;System.Reflection.TypeExtensions;System.Runtime.InteropServices.RuntimeInformation;System.Runtime.Numerics;System.Security.Cryptography.OpenSsl;System.Security.Cryptography.Primitives;System.Text.RegularExpressions;System.Xml.ReaderWriter;System.Xml.XDocument;</DroppedFacades>
  </PropertyGroup>
  <!-- SIPSorcery and its dependencies go in lib\, where the game doesn't look (see WebRtc/Libraries.cs) -->
  <PropertyGroup>
    <WebRtcLibraries>;BouncyCastle.Cryptography;Common.Logging;Common.Logging.Core;Concentus;DnsClient;Makaretu.Dns;Makaretu.Dns.Multicast;Microsoft.Extensions.DependencyInjection.Abstractions;Microsoft.Extensions.Logging.Abstractions;SIPSorcery;SIPSorceryMedia.Abstractions;SimpleBase;System.Diagnostics.DiagnosticSource;System.Net.IPNetwork;System.Threading.Tasks.Extensions;websocket-sharp;</WebRtcLibraries>
  </PropertyGroup>
  <Target Name="ArrangeLibraries" BeforeTargets="PostBuildEvent">
    <ItemGroup>
      <OutputDll Include="$(ProjectDir)$(OutDir)*.dll" />
      <WebRtcDll Include="@(OutputDll)" Condition="$(WebRtcLibraries.Contains(';%(Filename);'))" />
    </ItemGroup>
    <Delete Files="@(OutputDll)" Condition="$(DroppedFacades.Contains(';%(Filename);'))" />
    <Copy SourceFiles="@(WebRtcDll)" DestinationFolder="$(ProjectDir)$(OutDir)lib" />
    <Delete Files="@(WebRtcDll)" />
  </Target>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <!-- Empty -->
  </Target>

  <!-- A test run is using the Mods folder: a build that isn't the run's own would swap the DLL it plays (Tools/Tests/README.md) -->
  <PropertyGroup>
    <BBTestLock>$([System.IO.Path]::GetTempPath())bb-run-lock</BBTestLock>
    <InstallBlockedByTests Condition="Exists('$(BBTestLock)') AND '$(BB_HOLDS_LOCK)' != '1'">true</InstallBlockedByTests>
  </PropertyGroup>
  <Target Name="WarnInstallBlocked" AfterTargets="PostBuildEvent" Condition="'$(InstallBlockedByTests)' == 'true'">
    <Warning Text="A test run holds $(BBTestLock): not installing into the Mods folder, the run plays what is there. Build again once it is done." />
  </Target>

  <!-- PostBuild -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(InstallBlockedByTests)' != 'true'">
    <Message Importance="High" Text="DestinationFolder -&gt; $(VersionOutputPath)" />
    <!-- Create Folder -->
    <MakeDir Directories="$(VersionOutputPath)" />
    <ItemGroup>
      <!-- For copy -->
      <FilesToCopy Include="$(ProjectDir)$(OutDir)*" />
      <LocalizationFileToCopy Include="$(ProjectDir)$(OutDir)Localizations\*" />
      <KeyBindingFileToCopy Include="$(ProjectDir)$(OutDir)KeyBindings\*" />
      <KeyBindingGroupFileToCopy Include="$(ProjectDir)$(OutDir)KeyBindingGroups\*" />
      <!-- The buildings and what they need, with their folders -->
      <BuildingFileToCopy Include="$(ProjectDir)$(OutDir)Buildings\**\*" />
      <TemplateCollectionFileToCopy Include="$(ProjectDir)$(OutDir)TemplateCollections\*" />
      <LibraryFileToCopy Include="$(ProjectDir)$(OutDir)lib\*" />
      <SpriteFileToCopy Include="$(ProjectDir)$(OutDir)Sprites\**\*" />
      <SoundFileToCopy Include="$(ProjectDir)$(OutDir)Sounds\*" />
      <RootDirFilesToCopy Include="$(ProjectDir)thumbnail.png" />
      <!-- The Steam Workshop item to update: the uploader writes it into the mod folder on the first upload -->
      <RootDirFilesToCopy Include="$(ProjectDir)workshop_data.json" Condition="Exists('$(ProjectDir)workshop_data.json')" />
    </ItemGroup>
    <!-- Clear VersionOutputPath Directory & Copy Output files inside -->
    <RemoveDir Directories="$(VersionOutputPath)" />
    <MakeDir Directories="$(VersionOutputPath)" />
    <!-- The manifest only carries major.minor (a different manifest version makes the game warn on every save); the real version is here and in the DLL -->
    <WriteLinesToFile File="$(VersionOutputPath)version.txt" Lines="$(Version)" Overwrite="true" />
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(VersionOutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LocalizationFileToCopy)" DestinationFolder="$(VersionOutputPath)\Localizations" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(KeyBindingFileToCopy)" DestinationFolder="$(VersionOutputPath)\KeyBindings" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(KeyBindingGroupFileToCopy)" DestinationFolder="$(VersionOutputPath)\KeyBindingGroups" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BuildingFileToCopy)" DestinationFiles="@(BuildingFileToCopy->'$(VersionOutputPath)Buildings\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TemplateCollectionFileToCopy)" DestinationFolder="$(VersionOutputPath)\TemplateCollections" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LibraryFileToCopy)" DestinationFolder="$(VersionOutputPath)\lib" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SpriteFileToCopy)" DestinationFiles="@(SpriteFileToCopy->'$(VersionOutputPath)Sprites\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SoundFileToCopy)" DestinationFolder="$(VersionOutputPath)\Sounds" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RootDirFilesToCopy)" DestinationFolder="$(BeaverBuddiesModsPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
